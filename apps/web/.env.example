# Copy to .env.local and fill in. Never commit .env.local.

# Live model access. Without it the app runs in offline mode and says so.
XAI_API_KEY=
XAI_MODEL=grok-4.5

# PostgreSQL. Without it the audit trail is process-local and does not survive
# a restart — see apps/web/src/lib/ai/guard.ts. Matches docker-compose.yml.
DATABASE_URL=postgres://legalos:legalos@localhost:5433/legalos

# Production session HMAC signing key (recommended for production deployments)
SESSION_SIGNING_KEY=
